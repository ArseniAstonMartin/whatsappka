# Select one process role: backend or worker.
SPRING_PROFILES_ACTIVE=backend
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Runtime database role. Schema changes use a separate migration role in the root .env.
DB_URL=jdbc:postgresql://localhost:5432/whatsappka
DB_USERNAME=whatsappka_app
DB_PASSWORD=local-app-change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=local-redis-change-me

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=whatsappka-media
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
