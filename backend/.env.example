# Select one process role: backend or worker.
SPRING_PROFILES_ACTIVE=backend
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Runtime database role. Schema changes use a separate migration role in the root .env.
DB_URL=jdbc:postgresql://localhost:5432/whatsappka
DB_USERNAME=whatsappka_app
DB_PASSWORD=local-app-change-me

JWT_SECRET=local-jwt-change-me-to-random-string-of-at-least-32-bytes
REFRESH_COOKIE_SECURE=false
# Источники, с которых разрешены cookie-операции refresh и logout (через запятую).
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# Вход через Google. Пустые значения: вход отключён, сервер сообщит об этом явно.
# В Google Cloud укажите GOOGLE_REDIRECT_URI как разрешённый адрес перенаправления.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
APP_URL=http://localhost:4200

# Первый администратор создаётся один раз, если администратора в базе ещё нет. Пустой email — не создавать.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=local-redis-change-me

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=whatsappka-media
MINIO_ACCESS_KEY=whatsappka-app
MINIO_SECRET_KEY=local-minio-app-change-me
