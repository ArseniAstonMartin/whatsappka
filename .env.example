# Локальные значения-примеры. Скопируйте файл в .env и замените пароли вне своей машины.
# Роли разделены: администратор кластера, миграции и приложение.

POSTGRES_DB=whatsappka
POSTGRES_USER=whatsappka_admin
POSTGRES_PASSWORD=local-admin-change-me
POSTGRES_PORT=5432

DB_MIGRATION_PASSWORD=local-migrate-change-me

DB_USERNAME=whatsappka_app
DB_PASSWORD=local-app-change-me
DB_URL=jdbc:postgresql://localhost:5432/whatsappka

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-change-me
