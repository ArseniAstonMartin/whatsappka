# Локальные значения-примеры. Скопируйте файл в .env и замените пароли вне своей машины.
# Роли разделены: администратор кластера, миграции и приложение.

POSTGRES_DB=whatsappka
POSTGRES_USER=whatsappka_admin
POSTGRES_PASSWORD=local-admin-change-me
POSTGRES_PORT=5432

DB_MIGRATION_PASSWORD=local-migrate-change-me

# Подпись access JWT (HS256): не короче 32 байт, у каждой среды свой секрет.
JWT_SECRET=local-jwt-change-me-to-random-string-of-at-least-32-bytes

DB_USERNAME=whatsappka_app
DB_PASSWORD=local-app-change-me
DB_URL=jdbc:postgresql://localhost:5432/whatsappka

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-change-me

# Корень MinIO нужен только серверу и одноразовой инициализации bucket.
MINIO_ROOT_USER=whatsappka-root
MINIO_ROOT_PASSWORD=local-minio-root-change-me
MINIO_ACCESS_KEY=whatsappka-app
MINIO_SECRET_KEY=local-minio-app-change-me
MINIO_BUCKET=whatsappka-media
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
# Процесс на хосте. Внутри compose укажите http://minio:9000.
MINIO_ENDPOINT=http://127.0.0.1:9000
