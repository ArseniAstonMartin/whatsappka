# Шаблон переменных для внешнего контура (Coolify). Значения задаются в интерфейсе Coolify, не в git.
# Все значения CHANGE_ME_* и <домен> — заглушки: без реальных значений владельца стенд не запускается.
# Секреты: пароли и JWT_SECRET, ключи MinIO и Google, SMTP. Длина JWT_SECRET не меньше 32 байт.

# --- внешний origin: один домен, TLS на стороне Coolify/прокси ---
APP_URL=https://<домен>
ALLOWED_ORIGINS=https://<домен>
GOOGLE_REDIRECT_URI=https://<домен>/api/v1/auth/google/callback
# Cookie только по HTTPS. Для локальной сети по http оставьте false (см. docs).
REFRESH_COOKIE_SECURE=true

# --- Google: отдельный OAuth-клиент для домена (не тот, что для localhost) ---
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# --- база и служебные пароли (уникальные для среды) ---
POSTGRES_DB=whatsappka
POSTGRES_USER=whatsappka_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DB_USERNAME=whatsappka_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- JWT ---
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES

# --- MinIO (внутренний S3, наружу не публикуется) ---
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=whatsappka-media
MINIO_REGION=us-east-1

# --- почта: реальный SMTP провайдера владельца (mailpit для внешнего контура не используется) ---
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_STARTTLS=true
MAIL_FROM=WhatsAppka <no-reply@<домен>>

# --- первый администратор: заполнить только на первый запуск, затем очистить переменные ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- нагрузка (по PRD для M1/VM) ---
JOB_CONCURRENCY=2
OUTBOX_BATCH_SIZE=20
